#!/bin/sh
# Usage: project-extensions <skill> [<skill>...]
# Prints the SKILL.md path of every project skill whose frontmatter declares
# `extends:` naming one of the given skills. Always exits 0.

[ "$#" -gt 0 ] || exit 0

root=$(git rev-parse --show-toplevel 2>/dev/null) || root=$(pwd)

for dir in .claude/skills .agents/skills .agent/skills .codex/skills .pi/skills .omp/skills .github/skills; do
	[ -d "$root/$dir" ] && find -L "$root/$dir" -name SKILL.md -type f 2>/dev/null
done | while IFS= read -r file; do
	physical=$(cd -P "$(dirname "$file")" 2>/dev/null && pwd -P) || continue
	printf '%s\t%s\n' "$physical/SKILL.md" "$file"
done | awk -F '\t' '!seen[$1]++ { print $2 }' | while IFS= read -r file; do
	awk -v wanted="$*" '
		NR == 1 { if ($0 !~ /^---[[:space:]]*$/) exit 1; next }
		/^---[[:space:]]*$/ { exit 1 }
		/^[[:space:]]*extends:/ {
			value = $0
			sub(/^[[:space:]]*extends:[[:space:]]*/, "", value)
			sub(/[[:space:]]+#.*$/, "", value)
			gsub(/["'\''\[\],]/, " ", value)
			n = split(value, names, " ")
			m = split(wanted, targets, " ")
			for (i = 1; i <= n; i++)
				for (j = 1; j <= m; j++)
					if (names[i] == targets[j]) { found = 1; exit }
		}
		END { exit !found }
	' "$file" && printf '%s\n' "$file"
done

exit 0
