#!/usr/bin/env python3
from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path
from urllib.parse import unquote

ROOT = Path(__file__).resolve().parents[3]
GENERATED_MARKER = "generated by `peer route sync`"
LINK = re.compile(r"(?<!!)\[[^\]]+\]\(([^)]+)\)")
HEADING = re.compile(r"^#{1,6}\s+(.+?)\s*$", re.MULTILINE)
FENCED_BLOCK = re.compile(r"^(```|~~~).*?^\1\s*$", re.MULTILINE | re.DOTALL)

OWNERS = {
    "orientation trigger": ("instructions/AGENTS.md", "tools-and-context"),
    "orientation commands": ("skills/gestalt/SKILL.md", "subagent-orientation"),
    "single source of truth": ("instructions/AGENTS.md", "single-source-of-truth"),
    "RED validity": ("skills/test/SKILL.md", "red"),
    "review result gate": ("skills/review/reference/harnesses.md", "results"),
    "finding bar": ("skills/review/reference/finding-bar.md", "admission"),
    "test failure modes": ("skills/test/reference/failure-modes.md", "reject"),
    "routing": ("skills/peer/reference/routing.md", "registry"),
    "default reviewers": ("skills/peer/reference/routing.md", "default-reviewers"),
    "report layout": ("skills/peer/SKILL.md", "report-layout--peer"),
}

LEGACY_CLAUSES = (
    ("orientation trigger", re.compile(r"Run `gestalt map` as the first repository(?: tool)? action"), None),
    ("execution-class gate", re.compile(r"one successful report from every execution class", re.I), "skills/review/reference/harnesses.md"),
    ("absent-class gate", re.compile(r"Never require an absent class", re.I), None),
    ("RED accept list", re.compile(r"Accept an assertion failure", re.I), None),
    ("RED reject list", re.compile(r"Reject setup, import, syntax", re.I), None),
    ("passing RED", re.compile(r"passes immediately does not establish RED", re.I), "skills/test/SKILL.md"),
    ("report layout literal", re.compile(r"\.peer/<subject>/<run>/<stage>"), None),
    ("fixed reviewer count", re.compile(r"2×2|four reports|all four successful|two host-native reviewers", re.I), None),
    ("finding volume", re.compile(r"Report volume tracks", re.I), "skills/review/reference/finding-bar.md"),
    ("finding grouping", re.compile(r"Batch by mechanism", re.I), None),
    ("enumeration catalog", re.compile(r"Never request exhaustive input", re.I), None),
    ("obsolete failure-mode enum", re.compile(r"oracle_mirroring\s*\|"), None),
    ("SSOT owner", re.compile(r"Give every procedure, policy list"), "instructions/AGENTS.md"),
    ("SSOT consumer", re.compile(r"Consumers link to or load"), "instructions/AGENTS.md"),
)

REQUIRED_SNIPPETS = (
    (
        "native Codex role materialization",
        "skills/implement/reference/subagent-workflow.md",
        "{role_contract}",
        6,
    ),
)


def tracked_markdown() -> list[Path]:
    result = subprocess.run(
        ["git", "ls-files", "*.md"],
        cwd=ROOT,
        check=True,
        capture_output=True,
        text=True,
    )
    return [ROOT / line for line in result.stdout.splitlines() if line]


def slug(text: str) -> str:
    text = re.sub(r"<[^>]*>", "", text)
    text = re.sub(r"[`*_~]", "", text).strip().lower()
    text = "".join(char for char in text if char.isalnum() or char in " _-")
    return text.replace(" ", "-")


def anchors(text: str) -> set[str]:
    found: set[str] = set()
    counts: dict[str, int] = {}
    for heading in HEADING.findall(text):
        base = slug(heading)
        count = counts.get(base, 0)
        counts[base] = count + 1
        found.add(base if count == 0 else f"{base}-{count}")
    return found


def local_target(source: Path, raw: str) -> tuple[Path, str] | None:
    raw = unquote(raw.strip())
    if raw.startswith(("http://", "https://", "mailto:", "data:")):
        return None
    if raw.startswith("<") and raw.endswith(">"):
        raw = raw[1:-1]
    raw = raw.split(maxsplit=1)[0]
    path_text, separator, anchor = raw.partition("#")
    if path_text.startswith("/"):
        return None
    target = source if not path_text else (source.parent / path_text).resolve()
    return target, anchor if separator else ""


def main() -> int:
    files = tracked_markdown()
    texts = {
        path: path.read_text(encoding="utf-8") for path in files if path.is_file()
    }
    failures: list[str] = []

    for name, (relative, anchor) in OWNERS.items():
        path = ROOT / relative
        text = texts.get(path)
        if text is None:
            failures.append(f"{name}: owner missing: {relative}")
        elif anchor not in anchors(text):
            failures.append(f"{name}: owner anchor missing: {relative}#{anchor}")

    for name, path_text, snippet, minimum in REQUIRED_SNIPPETS:
        path = ROOT / path_text
        count = texts.get(path, "").count(snippet)
        if count < minimum:
            failures.append(
                f"{name}: {path_text} has {count} copies of {snippet!r}; need {minimum}"
            )

    for source, text in texts.items():
        if GENERATED_MARKER in text:
            continue
        prose = FENCED_BLOCK.sub("", text)
        relative = source.relative_to(ROOT).as_posix()
        for name, pattern, owner in LEGACY_CLAUSES:
            if pattern.search(prose) and relative != owner:
                failures.append(f"{name}: duplicated clause in {relative}; owner: {owner or 'none (legacy wording)'}")
        for raw in LINK.findall(prose):
            resolved = local_target(source, raw)
            if resolved is None:
                continue
            target, anchor = resolved
            if not target.exists():
                failures.append(f"link: {relative}: {raw} -> missing file")
                continue
            if anchor and target.is_file():
                target_text = texts.get(target)
                if target_text is None:
                    target_text = target.read_text(encoding="utf-8")
                if anchor not in anchors(target_text):
                    failures.append(f"link: {relative}: {raw} -> missing anchor")

    if failures:
        for failure in failures:
            print(f"FAIL  {failure}")
        print(f"\n{len(failures)} failing")
        return 1
    print(f"ok    workflow contracts ({len(texts)} tracked Markdown files)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
