#!/bin/sh
# Usage: resolve-slots <skill>.<slot> [...]
# Prints "<slot><TAB><SKILL.md path>" for every project skill whose frontmatter
# `provides:` names one of the given slots. Always exits 0.

[ "$#" -gt 0 ] || exit 0

root=$(git rev-parse --show-toplevel 2>/dev/null) || root=$(pwd)

for dir in .claude/skills .agents/skills .agent/skills .codex/skills .pi/skills .omp/skills .github/skills; do
	[ -d "$root/$dir" ] && find -L "$root/$dir" -name SKILL.md -type f 2>/dev/null
done | while IFS= read -r file; do
	physical=$(cd -P "$(dirname "$file")" 2>/dev/null && pwd -P) || continue
	printf '%s\t%s\n' "$physical/SKILL.md" "$file"
done | awk -F '\t' '!seen[$1]++ { print $2 }' | while IFS= read -r file; do
	awk -v wanted="$*" -v file="$file" '
		NR == 1 { if ($0 !~ /^---[[:space:]]*$/) exit; next }
		/^---[[:space:]]*$/ { exit }
		/^[[:space:]]*provides:/ {
			value = $0
			sub(/^[[:space:]]*provides:[[:space:]]*/, "", value)
			sub(/[[:space:]]+#.*$/, "", value)
			gsub(/["'\''\[\],]/, " ", value)
			n = split(value, names, " ")
			m = split(wanted, slots, " ")
			for (j = 1; j <= m; j++)
				for (i = 1; i <= n; i++)
					if (names[i] == slots[j]) { printf "%s\t%s\n", slots[j], file; break }
		}
	' "$file"
done

exit 0
