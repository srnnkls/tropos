#!/usr/bin/env bash
# Run: skills/peer/scripts/peer-preflight-test
set -uo pipefail

SCRIPT_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
PEER="$SCRIPT_DIR/peer"
export PEER_DISPATCH=cli  # headless path under test; peer-herdr-test owns pane dispatch
tmp=$(mktemp -d) || tmp=""
[[ -n "$tmp" && -d "$tmp" && "$tmp" != "$PWD" && "$tmp" != "/" ]] || {
  printf 'FAIL  refusing to run: temp dir resolved to %s\n' "${tmp:-<empty>}"; exit 1; }
trap 'rm -rf "$tmp"' EXIT
fails=0

mkdir -p "$tmp/bin"
cat >"$tmp/bin/pi" <<'STUB'
#!/usr/bin/env bash
for a in "$@"; do [[ "$a" == --list-models ]] || continue
  case "$STUB_MODE" in
    notice)
      printf '%s\n' 'No models available. Use /login to log into a provider via OAuth or API key. See:' \
        '  /opt/pi/node_modules/@earendil-works/pi-coding-agent/docs/providers.md' \
        '  /opt/pi/node_modules/@earendil-works/pi-coding-agent/docs/models.md'
      exit 0 ;;
    table_other_provider)
      printf '%s\n' 'provider  model  context  max-out  thinking  images' \
        'openrouter  z-ai/glm-5.2  1.0M  131.1K  yes  no'
      exit 0 ;;
    table_other_model)
      printf '%s\n' 'provider  model  context  max-out  thinking  images' \
        'google-vertex  gemini-2.5-pro  1.0M  65.5K  yes  yes'
      exit 0 ;;
    table_match)
      printf '%s\n' 'provider  model  context  max-out  thinking  images' \
        'google-vertex  gemini-3.7-flash  1.0M  65.5K  yes  yes'
      exit 0 ;;
  esac
done
printf '%s\n' '{"type":"message_end","message":{"role":"assistant","stopReason":"stop","content":[{"type":"text","text":"OK"}]}}'
STUB
chmod +x "$tmp/bin/pi"

cat >"$tmp/bin/codex" <<'STUB'
#!/usr/bin/env bash
[[ "${1:-}" == --version ]] && { printf 'codex-cli %s\n' "$STUB_CODEX_VERSION"; exit 0; }
exit 1
STUB
chmod +x "$tmp/bin/codex"
mkdir -p "$tmp/codex-home"
write_codex_cache() {  # CLIENT-VERSION
  printf '{"client_version":"%s","fetched_at":"%s","models":[{"slug":"gpt-listed"}]}\n' \
    "$1" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$tmp/codex-home/models_cache.json"
}

# Dispatch through the canonical report layout, as every real caller does, so the stderr
# assertions below see only preflight diagnostics.
run=$("$PEER" run-id)

check_codex() {  # NAME CACHE-VERSION WANT-MISCONFIG
  local name=$1 dir err
  write_codex_cache "$2"
  dir=$("$PEER" path preflight "codex-$2" --run "$run" -C "$tmp")
  err=$(STUB_CODEX_VERSION=0.159.2 CODEX_HOME="$tmp/codex-home" PATH="$tmp/bin:$PATH" \
    "$PEER" codex -o "$dir/report.yaml" --model gpt-unlisted --cap 30 --idle 10 'ping' 2>&1 >/dev/null)
  if { [[ "$3" == yes && "$err" == *"does not offer model 'gpt-unlisted'"* ]]; } ||
     { [[ "$3" == no && "$err" != *"does not offer model"* ]]; }; then
    printf 'ok    %s\n' "$name"
  else
    printf 'FAIL  %s\n      stderr: %s\n' "$name" "${err:-<empty>}"
    (( fails++ ))
  fi
}

check() {
  local name=$1 mode=$2 want_rc=$3 want_stderr=$4 reject_stderr=$5 rc err dir
  dir=$("$PEER" path preflight "$2" --run "$run" -C "$tmp")
  err=$(STUB_MODE="$mode" PATH="$tmp/bin:$PATH" \
    "$PEER" pi -o "$dir/report.yaml" --provider google-vertex --model gemini-3.7-flash \
    --cap 30 --idle 10 'ping' 2>&1 >/dev/null)
  rc=$?
  local bad=()
  (( rc == want_rc )) || bad+=("exit $rc (want $want_rc)")
  [[ -n "$want_stderr" && "$err" != *"$want_stderr"* ]] && bad+=("stderr missing '$want_stderr'")
  [[ -n "$reject_stderr" && "$err" == *"$reject_stderr"* ]] && bad+=("stderr must not contain '$reject_stderr'")
  if (( ${#bad[@]} == 0 )); then
    printf 'ok    %s\n' "$name"
  else
    printf 'FAIL  %s: %s\n      stderr: %s\n' "$name" "$(IFS='; '; echo "${bad[*]}")" "${err:-<empty>}"
    (( fails++ ))
  fi
}

check 'credential-less login notice does not blame the registry' notice 0 \
  'no provider table' 'fix the provider in'
check 'absent provider in a real table is misconfig'  table_other_provider 2 "has no provider 'google-vertex'" ''
check 'absent model in a real table is misconfig'     table_other_model    2 "does not offer model 'gemini-3.7-flash'" ''
check 'matching provider and model dispatches'        table_match          0 '' 'peer:'
check_codex 'a catalog from the installed codex rejects an unlisted model' 0.159.2 yes
check_codex 'a catalog left by an older codex does not reject a model'   0.154.0 no

printf '\n%s\n' "$( ((fails)) && echo "$fails failing" || echo 'all passing')"
exit $(( fails > 0 ))
