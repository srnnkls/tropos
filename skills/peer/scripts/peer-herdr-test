#!/usr/bin/env bash
# Run: skills/peer/scripts/peer-herdr-test
set -uo pipefail

SCRIPT_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
PEER="$SCRIPT_DIR/peer"
tmp=$(mktemp -d) || tmp=""
[[ -n "$tmp" && -d "$tmp" && "$tmp" != "$PWD" && "$tmp" != "/" ]] || {
  printf 'FAIL  refusing to run: temp dir resolved to %s\n' "${tmp:-<empty>}"; exit 1; }
tmp=$(cd "$tmp" && pwd -P)
marks=$(mktemp -d)  # outside the work tree, so a sandboxed headless reviewer can mark it
trap 'rm -rf "$tmp" "$marks"' EXIT
fails=0

check() {  # NAME CONDITION-RESULT
  if (( $2 == 0 )); then printf 'ok    %s\n' "$1"; else printf 'FAIL  %s\n' "$1"; (( fails++ )); fi
}

cat >"$tmp/registry.yaml" <<'REG'
reviewers:
  - id: paneable
    harness: claude
    model: stub-model
    alias: paneable
    effort: high
    native: false
    peer: true
  - id: paneable-two
    harness: claude
    model: stub-model-two
    alias: paneable-two
    effort: high
    native: false
    peer: true
defaults:
  reviewers: [paneable]
REG

mkdir -p "$tmp/bin"
cat >"$tmp/bin/gestalt" <<'STUB'
#!/usr/bin/env bash
printf 'FAKE REPOSITORY ORIENTATION\n'
STUB

# Stands in for the herdr CLI: records every call with the socket it targets, hands back the
# JSON shapes peer parses, and emulates the one behaviour that matters — a pane agent writing
# its own report file. The peer-review session runs once its server has been started, or
# from the outset under HERDR_STUB_SESSION=running.
cat >"$tmp/bin/herdr" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$HERDR_CALLS"
printf '%s\t%s\n' "${HERDR_SOCKET_PATH:-caller}" "$*" >>"$HERDR_CALLS.sockets"
case "$1 ${2:-}" in
  "--session peer-review")
    [[ "$3" == server ]] && : >"$HERDR_CALLS.server" ;;
  "session list")
    running=false
    [[ "${HERDR_STUB_SESSION:-}" == running || -e "$HERDR_CALLS.server" ]] && running=true
    printf '{"sessions":[{"name":"default","running":true,"socket_path":"caller"},{"name":"peer-review","running":%s,"socket_path":"/stub/peer-review.sock"}]}\n' "$running" ;;
  "pane current")
    [[ "${HERDR_STUB_MODE:-ok}" == stale ]] && exit 1
    printf '{"result":{"pane":{"pane_id":"w1:p1","workspace_id":"w1"}}}\n' ;;
  "workspace create")
    printf '{"result":{"workspace":{"workspace_id":"w9"},"tab":{"tab_id":"w9:t1"},"root_pane":{"pane_id":"w9:p1"}}}\n' ;;
  "workspace list")
    printf '%s\n' '{"result":{"workspaces":[
      {"workspace_id":"w1","label":"scratch","agent_status":"idle"},
      {"workspace_id":"w4","label":"peer-subject-done","agent_status":"done"},
      {"workspace_id":"w5","label":"peer-subject-live","agent_status":"working"},
      {"workspace_id":"w6","label":"peer-subject-stuck","agent_status":"blocked"},
      {"workspace_id":"w7","label":"peer-subject-quiet","agent_status":"idle"}]}}' ;;
  "workspace close") ;;
  "tab create")
    printf '{"result":{"tab":{"tab_id":"w9:t%s"},"root_pane":{"pane_id":"w9:p%s"}}}\n' 2 2 ;;
  "tab rename") ;;
  "pane read")
    printf 'PANE TRANSCRIPT for %s\n' "$3" ;;
  "pane run")
    if [[ -n "${HERDR_LAUNCHER_DUMP:-}" ]]; then
      launcher=$(printf '%s' "$4" | tr -d "'")
      cat "$launcher" >>"$HERDR_LAUNCHER_DUMP"
      profile=$(sed -n 's/.*sandbox-exec -f \([^ ]*\.sb\).*/\1/p' "$launcher")
      [[ -n "$profile" ]] && cat "$profile" >>"$HERDR_LAUNCHER_DUMP"
    fi
    : ;;
  "pane report-metadata") ;;
  "agent get")
    printf '{"result":{"agent":{"agent_status":"idle"}}}\n' ;;
  "agent wait") ;;
  "agent prompt")
    if [[ "${HERDR_STUB_MODE:-ok}" == noreport ]]; then
      printf '{"result":{"agent":{"agent_status":"idle"}}}\n'
      exit 0
    fi
    outfile=$(printf '%s\n' "$4" | sed -n 's/.*complete report to \([^ ]*\) .*/\1/p')
    [[ -n "$outfile" ]] && printf 'REPORT\n' >"$outfile"
    printf '{"result":{"agent":{"agent_status":"done"}}}\n' ;;
  *) printf '{"result":{}}\n' ;;
esac
STUB

cat >"$tmp/bin/claude" <<'STUB'
#!/usr/bin/env bash
printf 'headless claude ran\n' >>"${HEADLESS_MARKER:-/dev/null}"
printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"result":"OK"}'
STUB
cp "$tmp/bin/claude" "$tmp/bin/codex"
chmod +x "$tmp/bin"/*

run_id=$("$PEER" run-id)
herdr_env=( HERDR_ENV=1 HERDR_WORKSPACE_ID=w1 HERDR_PANE_ID=w1:p1 HERDR_SOCKET_PATH=caller )  # inherited; the live pane decides

fanout() {  # STAGE EXTRA-ENV...
  local stage=$1; shift
  local dir; dir=$("$PEER" path subject "$stage" --run "$run_id" -C "$tmp")
  HERDR_CALLS="$tmp/calls.$stage" \
    env "${herdr_env[@]}" "$@" PEER_REGISTRY="$tmp/registry.yaml" PATH="$tmp/bin:$PATH" \
    "$PEER" -d "$dir" -C "$tmp" --peers paneable,paneable-two --cap 30 'ping' 2>"$tmp/err.$stage"
}

# --- peer herdr reports the surface a fan-out started now would use ---------------------
surface() {  # EXTRA-ENV...
  HERDR_CALLS="$tmp/calls.surface" \
    env "${herdr_env[@]}" "$@" PEER_REGISTRY="$tmp/registry.yaml" PATH="$tmp/bin:$PATH" \
    "$PEER" herdr 2>/dev/null
}
[[ "$(surface)" == "$(printf 'panes\tpeer-review')" ]]
check 'peer herdr names the session panes would open in' $?

! grep -qE '^(--session|workspace create)' "$tmp/calls.surface"
check 'peer herdr starts no session and opens no workspace' $?

[[ "$(surface HERDR_STUB_MODE=stale)" == "$(printf 'headless\t-')" ]] \
  && [[ "$(surface PEER_DISPATCH=cli)" == "$(printf 'headless\t-')" ]]
check 'peer herdr reports headless for a stale pane and for the opt-out' $?

# --- peer herdr clean reaps finished rounds, and only those ------------------------------
cleaned=$(HERDR_CALLS="$tmp/calls.clean" HERDR_STUB_SESSION=running \
  env "${herdr_env[@]}" PEER_REGISTRY="$tmp/registry.yaml" PATH="$tmp/bin:$PATH" \
  "$PEER" herdr clean 2>"$tmp/err.clean")
[[ "$cleaned" == "$(printf 'closed\tw4\tpeer-subject-done\nclosed\tw7\tpeer-subject-quiet')" ]]
check 'peer herdr clean closes the settled peer workspaces' $?

! grep -qE '^workspace close w(1|5|6)$' "$tmp/calls.clean"
check 'peer herdr clean spares live peers and workspaces that are not peer rounds' $?

grep -qx "$(printf '/stub/peer-review.sock\tworkspace list')" "$tmp/calls.clean.sockets"
check 'peer herdr clean reads the peer-review session, not the caller session' $?

cleaned=$(HERDR_CALLS="$tmp/calls.clean-idle" \
  env "${herdr_env[@]}" PEER_REGISTRY="$tmp/registry.yaml" PATH="$tmp/bin:$PATH" \
  "$PEER" herdr clean 2>/dev/null)
[[ -z "$cleaned" && ! -e "$tmp/calls.clean-idle.server" ]]
check 'peer herdr clean without a running session starts none and closes nothing' $?

# --- a fan-out from inside a herdr pane runs in the peer-review session ------------------
manifest=$(fanout panes HEADLESS_MARKER="$marks/headless.panes")
calls="$tmp/calls.panes"

grep -qx -- '--session peer-review server' "$calls"
check 'a stopped peer-review session is started headless' $?

fanout running HERDR_STUB_SESSION=running >/dev/null
! grep -q -- '^--session' "$tmp/calls.running"
check 'a running peer-review session is reused' $?

grep -qx "$(printf 'caller\tpane current --current')" "$calls.sockets" \
  && ! grep -E $'\t''(workspace|tab|pane run|agent)' "$calls.sockets" | grep -qv '^/stub/peer-review.sock'
check 'everything after the live-pane check targets the peer-review socket' $?

grep -qF -- 'workspace create --cwd '"$tmp"' --label peer-subject-panes --no-focus' "$calls"
check 'the round opens one workspace named peer-<subject>-<stage>' $?

(( $(grep -c '^workspace create' "$calls") == 1 ))
check 'two peers share one workspace' $?

grep -qx 'tab rename w9:t1 paneable' "$calls" \
  && grep -qF -- 'tab create --workspace w9 --cwd '"$tmp"' --label paneable-two --no-focus' "$calls" \
  && ! grep -q '^pane split' "$calls"
check 'each peer gets its own tab named after it, the first taking the root tab' $?

grep -q '^pane report-metadata w9:p1 --source peer --title peer paneable ' "$calls" \
  && grep -q -- '--display-agent paneable (peer reviewer)' "$calls" \
  && grep -q -- '--token peer=paneable ' "$calls"
check 'each pane carries peer identity as herdr metadata' $?

[[ ! -s "$marks/headless.panes" ]]
check 'no headless harness process runs when panes are available' $?

grep -qF "$(printf 'paneable\tok')" <<< "$manifest" \
  && grep -qF "$(printf 'paneable-two\tok')" <<< "$manifest"
check 'a pane peer that writes its report reports ok' $?

[[ -s "$tmp/.peer/subject/$run_id/panes/paneable.yaml" ]]
check 'the report the pane agent wrote is the published report' $?

[[ -s "$tmp/.peer/subject/$run_id/panes/paneable.prompt.md" ]]
check 'a positional prompt is materialized beside the report' $?

prompt_dir=$("$PEER" path subject prompt-file --run "$run_id" -C "$tmp")
printf 'assignment from a caller file\n' >"$prompt_dir/prompt.md"
HERDR_CALLS="$tmp/calls.prompt-file" \
  env "${herdr_env[@]}" PEER_REGISTRY="$tmp/registry.yaml" PATH="$tmp/bin:$PATH" \
  "$PEER" -d "$prompt_dir" -C "$tmp" --peers paneable --cap 30 \
  --prompt-file "$prompt_dir/prompt.md" >/dev/null 2>"$tmp/err.prompt-file"
grep '^agent prompt ' "$tmp/calls.prompt-file" | grep -qF "Read $prompt_dir/prompt.md in full" \
  && [[ ! -e "$prompt_dir/paneable.prompt.md" ]]
check "a caller's prompt file is used where it lies" $?

grep -q "^pane run w9:p1 .*launch.sh" "$calls"
check 'each pane is started through a generated launcher script' $?

grep '^agent prompt ' "$calls" \
  | grep -qF 'complete report to '"$tmp"'/.peer/subject/'"$run_id"'/panes/paneable.yaml'
check 'the pane agent is told where to write its report' $?

grep -qx 'workspace close w9' "$calls"
check 'a clean round closes its own workspace' $?

fanout keep PEER_HERDR_KEEP=1 >/dev/null
! grep -q '^workspace close' "$tmp/calls.keep"
check 'PEER_HERDR_KEEP=1 keeps the workspace of a clean round' $?

# --- the reviewer sandbox survives the move into a pane ---------------------------------
fanout reviewer-sandbox HERDR_LAUNCHER_DUMP="$tmp/launchers.reviewer" >/dev/null
grep -qF 'sandbox-exec -f' "$tmp/launchers.reviewer" \
  && grep -qF "$tmp/.peer/subject/$run_id/reviewer-sandbox" "$tmp/launchers.reviewer"
check 'a pane reviewer launches behind a profile that opens only its stage directory' $?

fanout_one() {  # STAGE ROLE EXTRA-ENV...
  local stage=$1 role=$2; shift 2
  local dir; dir=$("$PEER" path subject "$stage" --run "$run_id" -C "$tmp")
  HERDR_CALLS="$tmp/calls.$stage" \
    env "${herdr_env[@]}" "$@" PEER_REGISTRY="$tmp/registry.yaml" PATH="$tmp/bin:$PATH" \
    "$PEER" -d "$dir" -C "$tmp" --peers paneable --agent "$role" --cap 30 'ping' 2>"$tmp/err.$stage"
}
fanout_one tester-sandbox tester HERDR_LAUNCHER_DUMP="$tmp/launchers.tester" >/dev/null
! grep -qF 'sandbox-exec' "$tmp/launchers.tester"
check 'a pane tester keeps write access to its work tree' $?

# --- a pane that produces no report is not an ok row ------------------------------------
started=$SECONDS
manifest=$(fanout noreport HERDR_STUB_MODE=noreport)
elapsed=$(( SECONDS - started ))
! grep -qF "$(printf '\tok\t')" <<< "$manifest" \
  && grep -qF "$(printf 'paneable\t')" <<< "$manifest"
check 'a pane that writes no report never reports ok' $?

grep -qF 'produced no report' "$tmp/err.noreport"
check 'the missing report names the pane it was expected from' $?

(( elapsed < 25 ))  # cap is 30; a settled agent must not hold the pane for the rest of it
check 'a settled agent that wrote nothing gives up long before the cap' $?

grep -qx 'workspace close w9' "$tmp/calls.noreport"
check 'a round with a failed peer still closes its workspace' $?

grep -qF 'PANE TRANSCRIPT' "$tmp/.peer/subject/$run_id/noreport/paneable.pane.log" \
  && grep -qF 'pane transcript is at' "$tmp/err.noreport"
check "a failed peer's pane transcript outlives the workspace as a file" $?

[[ ! -e "$tmp/.peer/subject/$run_id/panes/paneable.pane.log" ]]
check 'a peer that reported leaves no pane log behind' $?

# --- opt-out and absence both fall back to headless dispatch ----------------------------
manifest=$(fanout optout PEER_DISPATCH=cli HEADLESS_MARKER="$marks/headless.optout")
[[ ! -s "$tmp/calls.optout" ]] && [[ -s "$marks/headless.optout" ]]
check 'PEER_DISPATCH=cli forces the headless path inside a herdr pane' $?

yq '.defaults.dispatch = "cli"' "$tmp/registry.yaml" > "$tmp/registry.cli.yaml"
[[ "$(HERDR_CALLS="$tmp/calls.surface" env "${herdr_env[@]}" PEER_REGISTRY="$tmp/registry.cli.yaml" \
      PATH="$tmp/bin:$PATH" "$PEER" herdr 2>/dev/null)" == "$(printf 'headless\t-')" ]] \
  && [[ "$(HERDR_CALLS="$tmp/calls.surface" env "${herdr_env[@]}" PEER_DISPATCH=herdr \
      PEER_REGISTRY="$tmp/registry.cli.yaml" PATH="$tmp/bin:$PATH" "$PEER" herdr 2>/dev/null)" == "$(printf 'panes\tpeer-review')" ]]
check 'registry defaults.dispatch selects the surface, and PEER_DISPATCH overrides it' $?

dir=$("$PEER" path subject flag --run "$run_id" -C "$tmp")
manifest=$(HERDR_CALLS="$tmp/calls.flag" HEADLESS_MARKER="$marks/headless.flag" \
  env "${herdr_env[@]}" PEER_REGISTRY="$tmp/registry.yaml" PATH="$tmp/bin:$PATH" \
  "$PEER" -d "$dir" -C "$tmp" --peers paneable,paneable-two --cap 30 --dispatch cli 'ping' 2>"$tmp/err.flag")
[[ ! -s "$tmp/calls.flag" ]] && [[ -s "$marks/headless.flag" ]]
check '--dispatch cli forces the headless path inside a herdr pane' $?

HERDR_CALLS="$tmp/calls.bad" env "${herdr_env[@]}" PEER_REGISTRY="$tmp/registry.yaml" PATH="$tmp/bin:$PATH" \
  "$PEER" -d "$dir" -C "$tmp" --peers paneable --dispatch tmux 'ping' >/dev/null 2>"$tmp/err.bad"
[[ $? -eq 2 ]] && grep -q "dispatch must be herdr or cli" "$tmp/err.bad"
check 'an unknown dispatch value is a usage error' $?

manifest=$(fanout stale HERDR_STUB_MODE=stale HEADLESS_MARKER="$marks/headless.stale")
grep -q '^pane current' "$tmp/calls.stale" \
  && ! grep -qE '^(--session|workspace create)' "$tmp/calls.stale" \
  && [[ -s "$marks/headless.stale" ]]
check 'an inherited HERDR_ENV with no live pane falls back to headless' $?

dir=$("$PEER" path subject outside --run "$run_id" -C "$tmp")
HEADLESS_MARKER="$marks/headless.outside" HERDR_CALLS="$tmp/calls.outside" \
  env -u HERDR_ENV -u HERDR_PANE_ID -u HERDR_WORKSPACE_ID \
  PEER_REGISTRY="$tmp/registry.yaml" PATH="$tmp/bin:$PATH" \
  "$PEER" -d "$dir" -C "$tmp" --peers paneable --cap 30 'ping' >/dev/null 2>"$tmp/err.outside"
[[ ! -s "$tmp/calls.outside" ]] && [[ -s "$marks/headless.outside" ]]
check 'a peer called outside herdr never touches the herdr CLI' $?

printf '\n%s\n' "$( ((fails)) && echo "$fails failing" || echo 'all passing')"
exit $(( fails > 0 ))
