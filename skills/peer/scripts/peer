#!/usr/bin/env bash
# peer - external code-review harness: registry-driven reviewer dispatch, idle-stall
# watchdog, self-parallelising fan-out to codex and pi. Identity lives in reviewers.yaml;
# peer maps it to CLI flags and leaves provider credentials to the underlying CLI.
set +m

REGISTRY="${PEER_REGISTRY:-$(dirname "$(realpath "${BASH_SOURCE[0]}")")/reviewers.yaml}"
command -v yq >/dev/null 2>&1 || { printf '%s\n' "peer: yq not found" >&2; exit 3; }
[[ -r "$REGISTRY" ]] || { printf '%s\n' "peer: registry not readable at $REGISTRY" >&2; exit 3; }

IDS=(); declare -A HARNESS MODEL ALIAS EFFORT NATIVE PROVIDER
while IFS=$'\t' read -r _id _h _m _a _e _n _p; do
  [[ -n "$_id" ]] || continue
  IDS+=("$_id")
  HARNESS[$_id]=$_h; MODEL[$_id]=$_m; ALIAS[$_id]=$_a; EFFORT[$_id]=$_e; PROVIDER[$_id]=$_p
  [[ "$_n" == true ]] && NATIVE[$_id]=yes || NATIVE[$_id]=no
done < <(yq -r '.reviewers[] | [.id,.harness,.model,.alias,.effort,.native,(.provider // "")] | @tsv' "$REGISTRY")

_peer_resolve() {
  local t=$1 id
  [[ -n ${HARNESS[$t]:-} ]] && { printf '%s\n' "$t"; return 0; }
  for id in "${IDS[@]}"; do [[ ${ALIAS[$id]} == "$t" ]] && { printf '%s\n' "$id"; return 0; }; done
  return 1
}

_peer_validate() {
  case "$1" in ''|minimal|low|medium|high|xhigh) ;; *) printf '%s\n' "peer: invalid --effort '$1' (expected: minimal, low, medium, high, or xhigh)" >&2; return 2 ;; esac
  { [[ "$2" =~ ^[0-9]+$ ]] && (( 10#$2 >= 1 )); } || { printf '%s\n' "peer: invalid --idle '$2' (expected a positive integer of seconds)" >&2; return 2; }
  { [[ "$3" =~ ^[0-9]+$ ]] && (( 10#$3 >= 1 )); } || { printf '%s\n' "peer: invalid --cap '$3' (expected a positive integer of seconds)" >&2; return 2; }
  return 0
}

cmd="${1:-}"

# --- peer list -----------------------------------------------------------------------
if [[ "$cmd" == list ]]; then
  printf '%-16s %-7s %-11s %-26s %-7s %s\n' REVIEWER-ID HARNESS PROVIDER MODEL ALIAS RUN-BY-PEER
  for id in "${IDS[@]}"; do
    [[ ${NATIVE[$id]} == yes ]] && runnable='no (agent Task)' || runnable=yes
    printf '%-16s %-7s %-11s %-26s %-7s %s\n' "$id" "${HARNESS[$id]}" "${PROVIDER[$id]}" "${MODEL[$id]}" "${ALIAS[$id]}" "$runnable"
  done
  exit 0
fi

# --- peer get: one registry field for a reviewer (id|alias) — for doc injection -------
if [[ "$cmd" == get ]]; then
  shift
  field="${1:-}"; tok="${2:-}"
  gid=$(_peer_resolve "$tok") || { printf '%s\n' "peer get: unknown reviewer '$tok'" >&2; exit 2; }
  case "$field" in
    id)      printf '%s\n' "$gid" ;;
    model)   printf '%s\n' "${MODEL[$gid]}" ;;
    harness) printf '%s\n' "${HARNESS[$gid]}" ;;
    alias)   printf '%s\n' "${ALIAS[$gid]}" ;;
    effort)  printf '%s\n' "${EFFORT[$gid]}" ;;
    native)   printf '%s\n' "${NATIVE[$gid]}" ;;
    provider) printf '%s\n' "${PROVIDER[$gid]}" ;;
    *) printf '%s\n' "peer get: unknown field '$field' (id|model|harness|alias|effort|native|provider)" >&2; exit 2 ;;
  esac
  exit 0
fi

# --- parallel fan-out over external harnesses — the DEFAULT action -------------------
if [[ "$cmd" != codex && "$cmd" != pi ]]; then
  if [[ -z "$cmd" ]]; then
    printf '%s\n' "usage: peer [-d OUTDIR] [--reviewers id|alias,...] [--effort L] [--idle S] [--cap S] PROMPT   (parallel fan-out — default)" >&2
    printf '%s\n' "       peer <codex|pi> -o OUTFILE [--model M] [...] PROMPT   (single reviewer)" >&2
    printf '%s\n' "       peer list | peer get <id|model|harness|alias|effort|native> <id|alias>" >&2
    exit 0
  fi
  [[ "$cmd" == run ]] && shift
  outdir=""; reviewers=""; effort=""; idle=120; idle_set=0; cap=600
  while (( $# )); do
    case "$1" in
      -d|--out-dir)  outdir="$2"; shift 2 ;;
      --reviewers)   reviewers="$2"; shift 2 ;;
      --effort)      effort="$2"; shift 2 ;;
      --idle)        idle="$2"; idle_set=1; shift 2 ;;
      --cap)         cap="$2"; shift 2 ;;
      --) shift; break ;;
      -*) printf '%s\n' "peer: unknown flag $1" >&2; exit 2 ;;
      *) break ;;
    esac
  done
  prompt="$*"
  [[ -n "$outdir" && -n "$prompt" ]] || {
    printf '%s\n' "usage: peer -d OUTDIR [--reviewers id|alias,...] [--effort L] [--idle S] [--cap S] PROMPT" >&2
    exit 2
  }
  _peer_validate "$effort" "$idle" "$cap" || exit 2
  mkdir -p "$outdir" || exit 2

  want=(); ran=(); declare -A PID; ok=0

  if [[ -n "$reviewers" ]]; then
    IFS=',' read -ra want <<< "$reviewers"
  else
    for id in "${IDS[@]}"; do [[ ${NATIVE[$id]} == no ]] && want+=( "$id" ); done
  fi

  for tok in "${want[@]}"; do
    id=$(_peer_resolve "$tok") || { printf '%s\n' "peer: unknown reviewer '$tok' (see: peer list)" >&2; exit 2; }
    if [[ ${NATIVE[$id]} == yes ]]; then
      printf '%s\n' "peer: '$id' is agent-native (Claude Task) — dispatch from the agent, skipping here" >&2
      continue
    fi
    e="${effort:-${EFFORT[$id]}}"; [[ "$e" == - ]] && e=high
    idle_arg=(); (( idle_set )) && idle_arg=( --idle "$idle" )
    peer "${HARNESS[$id]}" --provider "${PROVIDER[$id]}" --model "${MODEL[$id]}" --effort "$e" \
         "${idle_arg[@]}" --cap "$cap" -o "$outdir/$id.yaml" "$prompt" &
    PID[$id]=$!
    ran+=( "$id" )
  done

  for id in "${ran[@]}"; do
    wait "${PID[$id]}"; rc=$?
    case $rc in 0) st=ok; (( ok++ )) ;; 124) st=stalled ;; 3) st=auth ;; *) st=error ;; esac
    printf '%s\t%s\t%s\n' "$id" "$st" "$outdir/$id.yaml"
  done
  (( ok > 0 )) && exit 0 || exit 1
fi

# --- single harness: codex|pi (also the unit the fan-out dispatches to) ---------------
harness="$cmd"; shift
effort=high; model=""; outfile=""; idle=120; idle_set=0; cap=600; provider=""
while (( $# )); do
  case "$1" in
    -o|--out)   outfile="$2"; shift 2 ;;
    --effort)   effort="$2"; shift 2 ;;
    --model)    model="$2"; shift 2 ;;
    --provider) provider="$2"; shift 2 ;;
    --idle)     idle="$2"; idle_set=1; shift 2 ;;
    --cap)      cap="$2"; shift 2 ;;
    --) shift; break ;;
    -*) printf '%s\n' "peer: unknown flag $1" >&2; exit 2 ;;
    *) break ;;
  esac
done
prompt="$*"
[[ -n "$harness" && -n "$outfile" && -n "$prompt" ]] || {
  printf '%s\n' "usage: peer <codex|pi> -o OUTFILE [--model M] [--effort L] [--idle S] [--cap S] PROMPT" >&2
  printf '%s\n' "       peer -d OUTDIR [--reviewers ...] PROMPT   (parallel fan-out — the default)" >&2
  exit 2
}
# Idle base is harness-specific: gemini-on-Vertex's legitimate mid-generation silence runs
# longer than codex's, so pi gets 180s vs codex's 120s before the prompt-size scaling.
(( idle_set )) || { _base=$([[ "$harness" == pi ]] && printf 180 || printf 120); _auto=$(( _base + ${#prompt} / 500 )); idle=$(( _auto > cap ? cap : _auto )); }
_peer_validate "$effort" "$idle" "$cap" || exit 2

case "$harness" in
  codex)  bin=codex ;;
  pi)     bin=pi
          if [[ -z "$model" ]]; then
            _def=$(yq -r '.defaults.pi // ""' "$REGISTRY")
            [[ -n "$_def" ]] && { model="${MODEL[$_def]}"; : "${provider:=${PROVIDER[$_def]}}"; }
          fi ;;
  *) printf '%s\n' "peer: unknown harness '$harness' (use codex|pi, or 'list'/'run')" >&2; exit 2 ;;
esac
command -v "$bin" >/dev/null 2>&1 || { printf '%s\n' "peer: $bin not found" >&2; exit 3; }

penv=(); pi_thinking=false
if [[ "$harness" == pi && -n "$provider" ]]; then
  while IFS= read -r _kv; do [[ -n "$_kv" ]] && penv+=("$_kv"); done \
    < <(prov="$provider" yq -r '.providers[strenv(prov)].env // {} | to_entries[] | .key + "=" + .value' "$REGISTRY")
  pi_thinking=$(prov="$provider" yq -r '.providers[strenv(prov)].thinking // false' "$REGISTRY")
fi

# peer communicates via OUTFILE + exit code + stderr; its stdout is not part of the
# contract. Scope fd1 to /dev/null for the run so no harness/job chatter leaks into a
# caller that captures our stdout. (A block redirect, not `exec` - `exec` would persist
# into the calling shell.)
{
for attempt in 1 2; do
  : >| "$outfile"
  fifo="${TMPDIR:-/tmp}/peer.$$.${outfile##*/}.$attempt.$RANDOM"
  mkfifo "$fifo" 2>/dev/null || { printf '%s\n' "peer: cannot create fifo" >&2; exit 1; }

  # Both harnesses are agentic and STREAM into the fifo so the idle watchdog applies.
  # </dev/null is load-bearing: these CLIs read stdin and block forever when it isn't
  # EOF'd (backgrounded under a non-EOF tool pipe), emitting nothing the watchdog would
  # then misread as a stall.
  if [[ "$harness" == codex ]]; then
    a=( exec -s read-only --json -o "$outfile" -c "model_reasoning_effort=$effort" )
    [[ -n "$model" ]] && a+=( -m "$model" )
    codex "${a[@]}" "$prompt" </dev/null >"$fifo" 2>&1 &
  else
    _targs=(); [[ "$pi_thinking" == true ]] && _targs=( --thinking "$effort" )
    env "${penv[@]}" pi -p --mode json --provider "$provider" --model "$model" "${_targs[@]}" "$prompt" </dev/null >"$fifo" 2>&1 &
  fi
  hpid=$!

  ( sleep "$cap"; kill -TERM "$hpid" 2>/dev/null ) &
  capper=$!

  log=""
  exec 3<"$fifo"
  while IFS= read -t "$idle" -r -u 3 line; do
    log+="$line"$'\n'
  done
  exec 3<&-

  stalled=0
  if kill -0 "$hpid" 2>/dev/null; then
    stalled=1
    kill -TERM "$hpid" 2>/dev/null; sleep 1; kill -KILL "$hpid" 2>/dev/null
  fi
  wait "$hpid" 2>/dev/null
  kill "$capper" 2>/dev/null; wait "$capper" 2>/dev/null
  rm -f "$fifo" 2>/dev/null

  if [[ "$harness" == pi && $stalled -eq 0 ]]; then
    printf '%s\n' "$log" | OUTFILE="$outfile" python3 -c '
import os,sys,json
last=None
for ln in sys.stdin:
    ln=ln.strip()
    if not ln: continue
    try: d=json.loads(ln)
    except Exception: continue
    m=d.get("message")
    if isinstance(m,dict) and m.get("role")=="assistant" and m.get("content"):
        last=m
if last:
    text="".join(p.get("text","") for p in last["content"] if isinstance(p,dict) and p.get("type")=="text")
    if text.strip(): open(os.environ["OUTFILE"],"w").write(text)
'
  fi

  # A produced report proves the harness authed and ran — succeed before any auth scan.
  # Scanning the stream for auth strings earlier misfires when the model's OWN output
  # quotes them (e.g. reviewing auth-handling code), classifying a clean run as auth.
  if (( stalled == 0 )) && [[ -s "$outfile" ]]; then
    exit 0
  fi

  if printf '%s\n' "$log" | grep -qiE 'unauthenticated|permission[_ ]denied|status[^0-9]{0,6}40[13]\b|\b40[13][[:space:]]+(unauthorized|forbidden)|invalid_grant|invalid_rapt|invalid_api_key|incorrect[_ ]api[_ ]key|no api key found|authentication[_ ](error|failed)|not[_ ]authenticated|refresh_token_invalidated|could not be refreshed|could not[^"]{0,40}credential|application default credentials|reauthenticat|token (has[_ ])?(been[_ ])?(expired|revoked)'; then
    printf '%s\n' "peer: $harness auth/availability error - authenticate the provider (codex login / gcloud auth application-default login / set the provider API key)" >&2
    exit 3
  fi
  (( attempt == 1 )) && printf '%s\n' "peer: $harness stalled/failed (no clean report) - retrying once" >&2
done

printf '%s\n' "peer: $harness failed twice - skip this reviewer" >&2
exit 124
} >/dev/null
