#!/usr/bin/env bash
# Pre-loaded context for the pr skill's `comments` route: PR metadata, inline
# review comments, the unresolved-thread map, non-anchored bodies, and the HEAD
# diff. Exits silently on the `tfcprr` route. Prints `no-pr` when none resolves.
set -uo pipefail

A="${*:-}"

case "$A" in
  tfcprr*) exit 0 ;;
esac

case "$A" in
  comments) A="" ;;
  "comments "*) A="${A#comments }" ;;
esac

PR="${A%% *}"
[ -n "$PR" ] || PR=$(gh pr view --json number -q .number 2>/dev/null)

if [ -z "$PR" ]; then
  echo no-pr
  exit 0
fi

REPO=$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null)

echo "== pr =="
gh pr view "$PR" --json number,title,state,headRefName,headRefOid,baseRefName,url 2>/dev/null || echo no-pr

echo "== inline comments =="
gh api "repos/$REPO/pulls/$PR/comments" --paginate \
  --jq '.[] | {node_id, user: .user.login, path, line, original_line, side, in_reply_to_id, body}' \
  2>/dev/null || echo no-pr

echo "== unresolved threads =="
gh review comments "$PR" --unresolved --ids --flat 2>/dev/null | head -60

echo "== review bodies =="
gh api "repos/$REPO/pulls/$PR/reviews" \
  --jq '.[] | select(.body != "") | {user: .user.login, state, body}' 2>/dev/null

echo "== conversation =="
gh api "repos/$REPO/issues/$PR/comments" --jq '.[] | {user: .user.login, body}' 2>/dev/null

echo "== diff =="
gh pr diff "$PR" 2>/dev/null | head -800 || echo no-pr
