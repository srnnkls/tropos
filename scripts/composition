#!/usr/bin/env bash
set -euo pipefail
root=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
cd "$root"
empty=$(mktemp -d)
trap 'rm -rf "$empty"' EXIT

henia slots --global skills --project "$empty" --check > /dev/null || {
	henia slots --global skills --project "$empty" --check >&2
	exit 1
}
resolution=$(henia slots --global skills --project "$empty" --json)
applied=$(for skill in skills/*/SKILL.md; do
	name=$(basename "$(dirname "$skill")")
	yq --front-matter=extract -o=json "[.henia.variables.context_commands[]?.slots // \"\"] | join(\" \")" "$skill" |
		jq -c --arg skill "$name" '{skill: $skill, slots: (split(" ") | map(select(. != "")))}'
done | jq -s .)

render() {
	jq -r --arg root "$root/" --argjson applied "$applied" '
		def within($slot): . == $slot or startswith($slot + ".");
		def related($a; $b): ($a | within($b)) or ($b | within($a));
		def link: "[\(.skill)](\(.path | ltrimstr($root)))";
		.providers as $providers
		| "<!-- Generated by scripts/composition from skill frontmatter; CI regenerates it on main. -->",
		"",
		"# Composition",
		"",
		"Every seam the Tropos skills expose: each slot, its type, the skill that owns it,",
		"the skills that preload its providers and the providers Tropos ships. The",
		"[Project slots](instructions/AGENTS.md#project-slots) contract defines types,",
		"priorities and shadowing; each owner'"'"'s Slots section states what a slot covers.",
		"",
		"| Slot | Type | Owner | Applied by | Providers |",
		"|---|---|---|---|---|",
		(.declarations | sort_by(.slot)[] as $owner
			| ($applied | map(select(any(.slots[]; related(.; $owner.slot))) | "[\(.skill)](skills/\(.skill)/SKILL.md)") | join(", ")) as $users
			| ($providers | map(select(.slot | within($owner.slot))) | group_by(.skill)
				| map("\(.[0] | {skill, path} | link) (\(map("`\(.entry)`") | join(", ")))") | join("; ")) as $filled
			| "| `\($owner.slot)` | `\($owner.type)` | [\($owner.path | ltrimstr($root) | split("/")[1])](\($owner.path | ltrimstr($root))#slots) | \(if $users == "" then "—" else $users end) | \(if $filled == "" then "—" else $filled end) |")
	' <<< "$resolution"
}

render > COMPOSITION.md
